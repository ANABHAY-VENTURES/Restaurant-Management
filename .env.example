# Anabhay Ventures — Restaurant Management Environment Variables

# Application
APP_NAME="Restaurant Management"
APP_ENV=development
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restaurant_db
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Secrets
JWT_SECRET=super_secret_anabhay_jwt_key_at_least_32_characters_long
MFA_ISSUER="Anabhay Ventures Restaurant OS"

# Frontend Web Port
FRONTEND_PORT=3000

